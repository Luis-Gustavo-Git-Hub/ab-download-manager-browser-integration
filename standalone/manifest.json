{
  "manifest_version": 3,
  "name": "Downloads Independentes",
  "version": "0.1.0",
  "description": "Gerencie downloads HTTP e HTTPS no navegador, sem aplicativo auxiliar.",
  "permissions": [
    "alarms",
    "contextMenus",
    "downloads",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "manager.html",
  "minimum_chrome_version": "120",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://downloads.sourceforge.net/*",
    "https://*.dl.sourceforge.net/*"
  ],
  "action": {
    "default_title": "Downloads Independentes"
  },
  "side_panel": {
    "default_path": "parallel.html"
  }
}
